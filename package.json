{
  "name": "dsh-plugin-market-entry",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Adds a plugin market entry button to the left sidebar.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/aug-245/dsh-plugin-market-entry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aug-245/dsh-plugin-market-entry.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "plugin-market"
  ]
}
